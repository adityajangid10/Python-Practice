import pandas as pd

file_path = '/content/Home_work_data.csv'
df = pd.read_csv(file_path)


print("=== SHAPE ===")
print(df.shape)
print("\n" + "="*50 + "\n")

print("=== HEAD (First 5 Rows) ===")
print(df.head())
print("\n" + "="*50 + "\n")

print("=== TAIL (Last 5 Rows) ===")
print(df.tail())
print("\n" + "="*50 + "\n")

print("=== INFO ===")
df.info()
print("\n" + "="*50 + "\n")

print("=== DESCRIBE ===")
print(df.describe(include='all'))
print("\n" + "="*50 + "\n")


non_num_cols = df.select_dtypes(include=['object']).columns.tolist()
num_cols = df.select_dtypes(include=['number']).columns.tolist()

print("Non-numerical Columns:", non_num_cols)
print("Numerical Columns:", num_cols)
print("\n" + "="*50 + "\n")

df_cleaned = df.dropna(subset=non_num_cols).copy()

for col in num_cols:
    df_cleaned[col] = df_cleaned[col].fillna(df_cleaned[col].mean())

print("=== CLEANED DATA SUMMARY ===")
print("New Shape after cleaning:", df_cleaned.shape)
print("\nNull counts after processing:")
print(df_cleaned.isnull().sum())
